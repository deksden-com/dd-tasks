{
  "schema_id": "dd-flow/flow-contract@6",
  "id": "dd-flow-canonical-2026-08",
  "contract_id": "dd-flow-canonical-2026-08",
  "version": 6,
  "status": "active",
  "source": ".memory-bank/dd-flow/common/runtime-contract.md",
  "specifications": [
    {"id": "SPC-004", "version": "0.2.0", "sha256": "c151193f2cbffa7a27daaa08b9b5c0f5626cb6cad642601b05e9ad5a2155664f"},
    {"id": "SPC-005", "version": "0.1.0", "sha256": "02622b24f3656c5707f4d50e22a70a85df22c18b1e9c80c725e24be997cf8dd1"},
    {"id": "SPC-006", "version": "0.1.0", "sha256": "4e70e5e7c243da28ac3acb31649cbc61d921c80925d65f6b0218c731f55bb8e8"}
  ],
  "stage_lifecycle": {
    "actions": ["stage_start", "stage_finish"],
    "start_command": "dd-flow stage start <RUN> --stage <stage> --json",
    "bootstrap_command": "dd-flow stage start --bootstrap --stage specify --project-root <root> --subject <label> --intake-file <path> --json",
    "finish_command": "dd-flow stage finish <RUN> --stage <stage> --json",
    "prompt_sections": [
      "stage_identity",
      "authoritative_runtime_facts",
      "preflight",
      "task_intake",
      "applicable_instructions",
      "required_context",
      "work_contract",
      "completion_contract"
    ],
    "current_write_alias": "@stage",
    "archive_pattern": "try-NNN"
  },
  "run": {
    "current_state": "run.json",
    "history": "timeline.jsonl",
    "sole_authority": true,
    "legacy_state": "retired"
  },
  "artifacts": {
    "finish_outputs": [
      "stage-report.json",
      "stage-report.md",
      "stage-report.html",
      "summary.md"
    ],
    "model_input": "semantic-only; status in stage-input.json; mechanical facts are CLI-owned",
    "mechanical_facts": "cli-owned"
  },
  "plan": {
    "semantic_source": ".memory-bank/protocol/<PRT-ID>/plan.json",
    "schema": ".memory-bank/dd-flow/schemas/protocol-plan.schema.json",
    "progress_projection": "run.json.plan_progress",
    "worker_projection": "run.json.workers",
    "coverage_source": "<RUN-home>/02-plan/aspect-map.json",
    "removed": ["runtime plan copy", "plan set", "aspect-job-map.json", "aspect-graph.json", "subagent-decision.md", "phase-summary.md", "manual PLAN report"]
  },
  "validation": {
    "permission_scope": "known-targets-only",
    "memory_bank_scope": "post-write-delta",
    "alias_policy": "typed-contained-fail-closed"
  },
  "workspace": {
    "manager": "official-worktrunk",
    "command": "wt switch --create <branch> --base <base> --format json",
    "project_hooks": [".worktreeinclude", ".config/wt.toml"],
    "feature_route_stage": "protocolize_start",
    "service_checkout_root": "$DD_FLOW_HOME/projects/<PRJ-ID>/checkouts/worktrees/<RUN>/<repo>",
    "feature_branch_template": "feature/run-<RUN>-<slug>",
    "fallbacks": "forbidden"
  },
  "lint": {
    "progress_channel": "stderr",
    "result_channel": "stdout",
    "default_concurrency": 32,
    "findings_order": "deterministic"
  },
  "removed_contracts": [
    "duplicate RUN locator state and schemas",
    "manual trace lifecycle",
    "runtime semantic plan copy",
    "plan set lifecycle",
    "aspect job/graph projections",
    "report format selectors",
    "observability detail selectors",
    "current try-NNN writes",
    "raw Git worktree fallback",
    "model-authored mechanical telemetry"
  ],
  "presets": {
    "compact": {"planning": "compact", "verification": "mandatory"},
    "normal": {"planning": "normal", "verification": "mandatory"},
    "full": {"planning": "full", "verification": "full"}
  },
  "policy": {
    "source_of_truth": "canonical prompts and schemas",
    "runtime_owner": "dd-flow-cli",
    "lint_owner": "mb-lint",
    "integrated_gate": "compatible releases plus clean specify-to-plan eval"
  }
}
