{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dd-flow/code-work-batch@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "entry", "sources", "works"],
  "properties": {
    "schema_id": {"const": "dd-flow/code-work-batch@1"},
    "entry": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["plan_id", "protocol_id", "revision", "sha256"], "properties": {"plan_id": {"type": "string", "minLength": 1}, "protocol_id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "works": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["key", "protocol_id", "plan_id", "plan_item_id", "task", "requirement_refs", "read_paths", "write_paths", "verification", "stop_conditions", "depends_on"], "properties": {"key": {"type": "string", "minLength": 1}, "protocol_id": {"type": "string", "minLength": 1}, "plan_id": {"type": "string", "minLength": 1}, "plan_item_id": {"type": "string", "minLength": 1}, "task": {"type": "string", "minLength": 1}, "requirement_refs": {"$ref": "#/$defs/strings"}, "read_paths": {"$ref": "#/$defs/strings"}, "write_paths": {"$ref": "#/$defs/strings"}, "verification": {"$ref": "#/$defs/strings"}, "stop_conditions": {"$ref": "#/$defs/strings"}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}}
  },
  "$defs": {"strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
}
