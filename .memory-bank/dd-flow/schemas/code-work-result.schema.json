{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dd-flow/code-work-result@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "summary", "changed_paths", "deviations", "blockers"],
  "properties": {
    "schema_id": {"const": "dd-flow/code-work-result@1"},
