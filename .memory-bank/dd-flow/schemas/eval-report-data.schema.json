{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dd-flow/eval-report-data@1",
  "title": "dd-flow eval report data",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "generated_at", "subject", "overall", "aspects", "findings", "evidence"],
  "properties": {
    "schema_id": { "const": "dd-flow/eval-report-data@1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "mode"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["exploratory", "baseline", "gate", "regression"] },
        "scenario_id": { "type": "string" },
        "run_id": { "type": "string" }
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "summary", "score", "score_max"],
      "properties": {
        "verdict": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "score": { "type": "number", "minimum": 0 },
        "score_max": { "type": "number", "exclusiveMinimum": 0 },
        "threshold": { "type": "number" },
        "next_action": { "type": "string" }
      }
    },
    "aspects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "score", "score_max", "verdict", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "score": { "type": "number", "minimum": 0 },
          "score_max": { "type": "number", "exclusiveMinimum": 0 },
          "verdict": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "aspect", "summary", "evidence"],
        "properties": {
          "severity": { "type": "string", "minLength": 1 },
          "aspect": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "next_action": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "href", "what_it_proves"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "href": { "type": "string", "minLength": 1 },
          "what_it_proves": { "type": "string", "minLength": 1 },
          "what_it_does_not_prove": { "type": "string" }
        }
      }
    },
    "scenario_id": { "type": "string", "minLength": 1 },
    "fixture_hash": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["passed", "failed", "invalid"] },
    "gate_status": { "type": "string", "enum": ["pass", "fail"] },
    "threshold": { "type": "string", "minLength": 1 },
    "group_verdict": { "type": "string", "minLength": 1 },
    "stage_verdict": { "type": "string", "minLength": 1 },
    "effective_pool": { "type": "integer", "minimum": 1 },
    "pool_source": { "type": "string", "enum": ["runtime", "explicit", "fallback"] },
    "counts": { "type": "object", "additionalProperties": true },
    "baseline_unit_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "optimized_unit_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "unit_evidence_equal": { "type": "boolean" },
    "unit_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["unit_id", "applicability", "route", "group_id", "job_id", "session_id", "session_id_status", "completeness", "verdict", "evidence_refs", "report_ref", "attempt_id"],
        "properties": {
          "unit_id": { "type": "string", "minLength": 1 },
          "applicability": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "minLength": 1 },
          "group_id": { "type": ["string", "null"] },
          "job_id": { "type": "string", "minLength": 1 },
          "session_id": { "type": ["string", "null"] },
          "session_id_status": { "type": "string", "minLength": 1 },
          "completeness": { "type": "string", "minLength": 1 },
          "verdict": { "type": "string", "minLength": 1 },
          "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "report_ref": { "type": "string", "minLength": 1 },
          "attempt_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["unit_id", "attempt_id", "parent_attempt_id", "report_ref", "promotion", "stale_or_duplicate_rejected"],
        "properties": {
          "unit_id": { "type": "string", "minLength": 1 },
          "attempt_id": { "type": "string", "minLength": 1 },
          "parent_attempt_id": { "type": ["string", "null"] },
          "report_ref": { "type": "string", "minLength": 1 },
          "promotion": { "type": "string", "minLength": 1 },
          "stale_or_duplicate_rejected": { "type": "boolean" }
        }
      }
    },
    "successor_locks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["unit_id", "reason", "locked"],
        "properties": {
          "unit_id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "locked": { "type": "boolean" }
        }
      }
    },
    "rejections": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "what_it_does_not_prove": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "case_results": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  }
}
