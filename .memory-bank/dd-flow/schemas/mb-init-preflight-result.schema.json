{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dd-flow/mb-init-preflight-result@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "run_id",
    "stage",
    "input_sha256",
    "outcome",
    "summary",
    "predecessors",
    "units",
    "findings",
    "details"
  ],
  "properties": {
    "schema_id": {
      "const": "dd-flow/mb-init-preflight-result@1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "const": "preflight"
    },
    "input_sha256": {
      "$ref": "#/$defs/hash"
    },
    "outcome": {
      "enum": [
        "accepted",
        "needs_repair",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "predecessors": {
      "type": "array",
      "minItems": 0,
      "maxItems": 0,
      "items": {
        "$ref": "#/$defs/predecessor"
      }
    },
    "units": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "findings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_scope"
      ],
      "properties": {
        "bootstrap_receipts": {
          "description": "Optional legacy information; CLI independently selects and validates bootstrap custody.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "source_baseline_sha256": {
          "description": "Optional legacy information; CLI independently validates original source preservation.",
          "$ref": "#/$defs/hash"
        },
        "preserved_paths": {
          "description": "Optional legacy information, not a selection of paths authorized for preservation or mutation.",
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "semantic_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "result",
        "input_sha256"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "result": {
          "$ref": "#/$defs/reference"
        },
        "input_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_-][a-zA-Z0-9_.-]*)*$"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "aspect",
        "applicability",
        "outcome",
        "reason",
        "next_action",
        "evidence",
        "artifacts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "aspect": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "enum": [
            "applicable",
            "not-applicable",
            "unknown"
          ]
        },
        "outcome": {
          "enum": [
            "accepted",
            "not-applicable",
            "needs_repair",
            "blocked"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 0,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "unknown"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "next_action": {
                "type": "string",
                "minLength": 1
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "not-applicable"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "not-applicable"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "path",
        "sha256"
      ],
      "properties": {
        "root": {
          "enum": [
            "project",
            "workspace",
            "canon",
            "run"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unit_id",
        "severity",
        "statement",
        "evidence",
        "status",
        "resolution_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "unit_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "severity": {
          "enum": [
            "critical",
            "major",
            "minor"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "deferred"
          ]
        },
        "resolution_refs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "resolution_refs": {
                "minItems": 1,
                "type": "array"
              }
            },
            "type": "object"
          }
        }
      ]
    }
  }
}
