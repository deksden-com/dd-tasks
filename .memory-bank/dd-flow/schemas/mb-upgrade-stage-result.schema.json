{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dd-flow/mb-upgrade-stage-result@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "run_id",
    "stage",
    "input_sha256",
    "outcome",
    "summary",
    "predecessors",
    "units",
    "findings",
    "details"
  ],
  "properties": {
    "schema_id": {
      "const": "dd-flow/mb-upgrade-stage-result@1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "preflight",
        "diff-analysis",
        "upgrade",
        "verify",
        "review",
        "finish"
      ]
    },
    "input_sha256": {
      "$ref": "#/$defs/hash"
    },
    "outcome": {
      "enum": [
        "accepted",
        "needs_repair",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "predecessors": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/predecessor"
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "findings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "details": {
      "type": "object"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "result",
        "input_sha256"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "result": {
          "$ref": "#/$defs/reference"
        },
        "input_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_-][a-zA-Z0-9_.-]*)*$"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "migrationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:[a-zA-Z0-9_-][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_-][a-zA-Z0-9_.-]*)*|\\.memory-bank/archive/mb-upgrade/[a-f0-9]{64}/migration\\.json)$"
        },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "aspect",
        "applicability",
        "outcome",
        "reason",
        "next_action",
        "evidence",
        "artifacts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "aspect": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "enum": [
            "applicable",
            "not-applicable",
            "unknown"
          ]
        },
        "outcome": {
          "enum": [
            "accepted",
            "not-applicable",
            "needs_repair",
            "blocked"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 0,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "artifacts": {
          "$comment": "Runtime projects all retained unit outputs; the stage byte bound and exact publication custody bound this array.",
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "unknown"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "next_action": {
                "type": "string",
                "minLength": 1
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "not-applicable"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "not-applicable"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "path",
        "sha256"
      ],
      "properties": {
        "root": {
          "enum": [
            "project",
            "workspace",
            "canon",
            "run"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unit_id",
        "severity",
        "statement",
        "evidence",
        "status",
        "resolution_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "unit_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "severity": {
          "enum": [
            "critical",
            "major",
            "minor"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "deferred"
          ]
        },
        "resolution_refs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "resolution_refs": {
                "minItems": 1,
                "type": "array"
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "task",
        "role",
        "unit_ids",
        "depends_on",
        "read_scopes",
        "write_scopes",
        "profile_id"
      ],
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S"
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "role": {
          "enum": [
            "writer",
            "index-assembly"
          ]
        },
        "unit_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "uniqueItems": true
        },
        "depends_on": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "uniqueItems": true
        },
        "read_scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/scope"
          }
        },
        "write_scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/scope"
          }
        },
        "profile_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "path"
      ],
      "properties": {
        "root": {
          "enum": [
            "workspace",
            "run"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unit_id",
        "statement",
        "expected",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "pathChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "from",
        "to",
        "action",
        "ownership",
        "reason",
        "evidence"
      ],
      "properties": {
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "to": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "action": {
          "enum": [
            "retain",
            "add",
            "update",
            "move",
            "archive",
            "semantic-work"
          ]
        },
        "ownership": {
          "enum": [
            "canonical",
            "project",
            "generated",
            "local-customized"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "invariant_id",
        "outcome",
        "summary",
        "evidence"
      ],
      "properties": {
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "invariant_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "preserved",
            "needs_repair",
            "blocked"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_work_id",
        "input_sha256",
        "result",
        "unit_ids"
      ],
      "properties": {
        "reviewer_work_id": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "$ref": "#/$defs/hash"
        },
        "result": {
          "$ref": "#/$defs/reference"
        },
        "unit_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "stage": {
          "const": "preflight"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semantic_scope",
            "preservation_invariants"
          ],
          "properties": {
            "semantic_scope": {
              "type": "string",
              "minLength": 1
            },
            "preservation_invariants": {
              "type": "array",
              "minItems": 0,
              "maxItems": 4096,
              "items": {
                "$ref": "#/$defs/invariant"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "stage": {
          "const": "diff-analysis"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "rationale",
            "path_map",
            "required_checks",
            "preservation_invariants"
          ],
          "properties": {
            "mode": {
              "enum": [
                "patch",
                "targeted_minor",
                "full_migration"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "path_map": {
              "type": "array",
              "minItems": 0,
              "maxItems": 4096,
              "items": {
                "$ref": "#/$defs/pathChange"
              }
            },
            "required_checks": {
              "type": "array",
              "minItems": 0,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "preservation_invariants": {
              "type": "array",
              "minItems": 0,
              "maxItems": 4096,
              "items": {
                "$ref": "#/$defs/invariant"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "stage": {
          "const": "upgrade"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "works",
            "assembly_work_keys",
            "migration_record"
          ],
          "properties": {
            "works": {
              "type": "array",
              "minItems": 0,
              "maxItems": 4096,
              "items": {
                "$ref": "#/$defs/work"
              }
            },
            "assembly_work_keys": {
              "type": "array",
              "minItems": 0,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "migration_record": {
              "$ref": "#/$defs/migrationRecord"
            }
          }
        }
      }
    },
    {
      "properties": {
        "stage": {
          "const": "verify"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checks",
            "preservation_assessments"
          ],
          "properties": {
            "checks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "$ref": "#/$defs/reference"
              }
            },
            "preservation_assessments": {
              "type": "array",
              "minItems": 0,
              "maxItems": 4096,
              "items": {
                "$ref": "#/$defs/assessment"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "stage": {
          "const": "review"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviews",
            "repair_wave",
            "repair_work_ids"
          ],
          "properties": {
            "reviews": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "$ref": "#/$defs/review"
              }
            },
            "repair_wave": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "repair_work_ids": {
              "type": "array",
              "minItems": 0,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    {
      "properties": {
        "stage": {
          "const": "finish"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coverage",
            "checks",
            "integration",
            "normal_flow_readiness",
            "migration_record"
          ],
          "properties": {
            "coverage": {
              "$ref": "#/$defs/reference"
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "$ref": "#/$defs/reference"
              }
            },
            "integration": {
              "$ref": "#/$defs/reference"
            },
            "normal_flow_readiness": {
              "$ref": "#/$defs/reference"
            },
            "migration_record": {
              "$ref": "#/$defs/migrationRecord"
            }
          }
        }
      }
    }
  ]
}
