{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dd-flow/memory-review-work-result@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "run_id", "work_id", "packet_sha256", "unit_id", "wave", "outcome", "summary", "evidence", "findings"],
  "properties": {
    "schema_id": { "const": "dd-flow/memory-review-work-result@1" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "work_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "packet_sha256": { "$ref": "#/$defs/hash" },
    "unit_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "wave": { "type": "integer", "minimum": 0, "maximum": 2 },
    "outcome": { "enum": ["accepted", "needs_repair", "blocked"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "evidence": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/reference" } },
    "findings": {
      "type": "array", "maxItems": 1024,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "unit_id", "severity", "summary", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "unit_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "severity": { "enum": ["minor", "major", "critical"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 16384 },
          "evidence": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/reference" } }
        }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["root", "path", "sha256"],
      "properties": {
        "root": { "enum": ["run", "workspace"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
