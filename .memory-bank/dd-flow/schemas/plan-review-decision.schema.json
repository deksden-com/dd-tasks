{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dd-flow/plan-review-decision@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "outcome", "summary", "finding_decisions", "invalidated_groups"],
  "properties": {
    "schema_id": {"const": "dd-flow/plan-review-decision@1"},
