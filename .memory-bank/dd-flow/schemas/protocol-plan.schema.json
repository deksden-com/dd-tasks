{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dd-flow/protocol-plan@2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "plan_id", "protocol_id", "revision", "title", "summary", "source_refs", "goal", "assessment", "decisions", "document_updates", "items", "acceptance", "policy_context", "code_handoff"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_id": {"const": "dd-flow/protocol-plan@2"},
    "plan_id": {"type": "string", "minLength": 1},
    "protocol_id": {"type": "string", "pattern": "^PRT-"},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/sourceRef"}},
    "goal": {"type": "object", "additionalProperties": false, "required": ["outcome", "constraints", "non_goals"], "properties": {"outcome": {"type": "string", "minLength": 1}, "constraints": {"$ref": "#/definitions/nonEmptyStrings"}, "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "assessment": {"type": "object", "additionalProperties": false, "required": ["scope_breadth", "solution_novelty", "solution_uncertainty", "failure_impact", "selected_depth", "depth_trigger"], "properties": {"scope_breadth": {"$ref": "#/definitions/scopeAxis"}, "solution_novelty": {"$ref": "#/definitions/noveltyAxis"}, "solution_uncertainty": {"$ref": "#/definitions/uncertaintyAxis"}, "failure_impact": {"$ref": "#/definitions/impactAxis"}, "selected_depth": {"enum": ["compact_plan", "full_plan"]}, "depth_trigger": {"enum": ["none", "explicit_full", "irreversible_data", "security_trust", "runtime_concurrency", "high_uncertainty", "high_failure_impact", "external_delivery"]}}},
    "decisions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "decision", "rationale", "affected_surfaces"], "properties": {"id": {"type": "string", "minLength": 1}, "decision": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}, "affected_surfaces": {"$ref": "#/definitions/nonEmptyStrings"}, "durable_ref": {"type": "string", "minLength": 1}}}},
    "document_updates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "action", "owner", "reason"], "properties": {"path": {"type": "string", "minLength": 1}, "action": {"enum": ["create", "update"]}, "owner": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}}},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/item"}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/acceptance"}},
    "policy_context": {"type": "object", "additionalProperties": false, "required": ["sources", "git", "workspace", "checks", "delivery", "operations", "gaps"], "properties": {"sources": {"$ref": "#/definitions/nonEmptyStrings"}, "git": {"type": "object"}, "workspace": {"type": "object"}, "checks": {"type": "object"}, "delivery": {"type": "object"}, "operations": {"type": "object"}, "gaps": {"type": "object"}}},
    "code_handoff": {"type": "object", "additionalProperties": false, "required": ["must_read", "workspace_route", "bootstrap", "env_policy", "secret_policy", "preserved_invariants", "current_blockers", "next_stage"], "properties": {"must_read": {"$ref": "#/definitions/nonEmptyStrings"}, "workspace_route": {"type": "string", "minLength": 1}, "bootstrap": {"type": "string", "minLength": 1}, "env_policy": {"type": "string", "minLength": 1}, "secret_policy": {"type": "string", "minLength": 1}, "preserved_invariants": {"$ref": "#/definitions/nonEmptyStrings"}, "current_blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}, "next_stage": {"const": "code"}}}
  },
  "definitions": {
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "sourceRef": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "path", "requirement_ids"], "properties": {"kind": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "requirement_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "version": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "axisBase": {"type": "object", "additionalProperties": false, "required": ["level", "surfaces", "reason"], "properties": {"level": {"type": "string"}, "surfaces": {"$ref": "#/definitions/nonEmptyStrings"}, "reason": {"type": "string", "minLength": 1}}},
    "scopeAxis": {"allOf": [{"$ref": "#/definitions/axisBase"}, {"type": "object", "properties": {"level": {"enum": ["narrow", "moderate", "broad"]}}}]},
    "noveltyAxis": {"allOf": [{"$ref": "#/definitions/axisBase"}, {"type": "object", "properties": {"level": {"enum": ["established", "adapted", "novel"]}}}]},
    "uncertaintyAxis": {"allOf": [{"$ref": "#/definitions/axisBase"}, {"type": "object", "properties": {"level": {"enum": ["low", "medium", "high"]}}}]},
    "impactAxis": {"allOf": [{"$ref": "#/definitions/axisBase"}, {"type": "object", "properties": {"level": {"enum": ["low", "medium", "high"]}}}]},
    "item": {"type": "object", "additionalProperties": false, "required": ["id", "title", "summary", "details", "depends_on", "requirement_refs", "semantic_spine", "execution_context", "verification"], "properties": {"id": {"type": "string", "pattern": "^P[0-9]+$"}, "title": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}, "details": {"type": "string", "minLength": 1}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^P[0-9]+$"}}, "requirement_refs": {"$ref": "#/definitions/nonEmptyStrings"}, "semantic_spine": {"type": "object", "additionalProperties": false, "required": ["user_outcome", "component_responsibility", "must_preserve", "non_goals", "acceptance_contribution"], "properties": {"user_outcome": {"type": "string", "minLength": 1}, "component_responsibility": {"type": "string", "minLength": 1}, "must_preserve": {"$ref": "#/definitions/nonEmptyStrings"}, "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}}, "acceptance_contribution": {"type": "string", "minLength": 1}}}, "execution_context": {"type": "object", "additionalProperties": false, "required": ["required_read", "discovery_boundary", "write_scope", "checks", "stop_conditions"], "properties": {"required_read": {"$ref": "#/definitions/nonEmptyStrings"}, "discovery_boundary": {"$ref": "#/definitions/nonEmptyStrings"}, "write_scope": {"$ref": "#/definitions/nonEmptyStrings"}, "checks": {"$ref": "#/definitions/nonEmptyStrings"}, "stop_conditions": {"$ref": "#/definitions/nonEmptyStrings"}}}, "verification": {"type": "object", "additionalProperties": false, "required": ["checks", "expected_evidence", "proof_limits"], "properties": {"checks": {"$ref": "#/definitions/nonEmptyStrings"}, "expected_evidence": {"$ref": "#/definitions/nonEmptyStrings"}, "proof_limits": {"$ref": "#/definitions/nonEmptyStrings"}}}}},
    "acceptance": {"type": "object", "additionalProperties": false, "required": ["criterion_id", "plan_item_ids", "changed_surfaces", "path", "environment", "fixtures", "cleanup", "expected_evidence", "proof_limits", "gate"], "properties": {"criterion_id": {"type": "string", "pattern": "^AC-[0-9]+$"}, "plan_item_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^P[0-9]+$"}}, "changed_surfaces": {"$ref": "#/definitions/nonEmptyStrings"}, "path": {"type": "string", "minLength": 1}, "environment": {"type": "string", "minLength": 1}, "fixtures": {"type": "array", "items": {"type": "string", "minLength": 1}}, "cleanup": {"type": "string", "minLength": 1}, "expected_evidence": {"$ref": "#/definitions/nonEmptyStrings"}, "proof_limits": {"$ref": "#/definitions/nonEmptyStrings"}, "gate": {"enum": ["code", "readiness", "merge", "release", "external"]}}}
  }
}
