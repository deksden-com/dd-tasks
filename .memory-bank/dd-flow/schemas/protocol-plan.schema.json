{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dd-flow/protocol-plan@2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "plan_id", "protocol_id", "revision", "title", "summary", "source_refs", "goal", "assessment", "decisions", "document_updates", "items", "acceptance", "policy_context", "code_handoff"],
  "properties": {
    "$schema": {"type": "string"}, "schema_id": {"const": "dd-flow/protocol-plan@2"}, "plan_id": {"type": "string", "minLength": 1}, "protocol_id": {"type": "string", "pattern": "^PRT-"}, "revision": {"type": "integer", "minimum": 1}, "title": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "items": {"type": "object", "required": ["kind", "id", "path", "sha256"], "properties": {"kind": {"type": "string"}, "id": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string"}}}},
    "goal": {"type": "object", "required": ["outcome", "constraints", "non_goals"], "properties": {"outcome": {"type": "string"}, "constraints": {"type": "array"}, "non_goals": {"type": "array"}}},
    "assessment": {"type": "object", "required": ["scope_breadth", "solution_novelty", "solution_uncertainty", "failure_impact", "selected_depth", "depth_trigger"], "properties": {"scope_breadth": {"$ref": "#/definitions/axis"}, "solution_novelty": {"$ref": "#/definitions/axis"}, "solution_uncertainty": {"$ref": "#/definitions/axis"}, "failure_impact": {"$ref": "#/definitions/axis"}, "selected_depth": {"enum": ["compact_plan", "full_plan"]}, "depth_trigger": {"type": "string"}}},
    "decisions": {"type": "array"}, "document_updates": {"type": "array"},
    "items": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "summary", "details", "depends_on", "requirement_refs", "semantic_spine", "execution_context", "verification"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "summary": {"type": "string", "minLength": 1}, "details": {"type": "string", "minLength": 1}, "depends_on": {"type": "array"}, "requirement_refs": {"type": "array"}, "semantic_spine": {"type": "object"}, "execution_context": {"type": "object"}, "verification": {"type": "object"}}}},
    "acceptance": {"type": "array"}, "policy_context": {"type": "object"}, "code_handoff": {"type": "object"}
  },
  "definitions": {"axis": {"type": "object", "required": ["level", "surfaces", "reason"], "properties": {"level": {"type": "string"}, "surfaces": {"type": "array"}, "reason": {"type": "string"}}}}
}
