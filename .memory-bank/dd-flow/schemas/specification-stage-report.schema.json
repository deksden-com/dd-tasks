{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dd-flow/specification-stage-report@2",
  "title": "Specification stage report data",
  "type": "object",
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": { "schema_id": { "const": "dd-flow/specification-stage-report@2" } },
        "required": ["schema_id"]
      },
      "then": {
        "required": ["task_assessment", "legacy_projection"],
        "allOf": [
          {
            "oneOf": [
              { "properties": { "task_assessment": { "properties": { "scope_breadth": { "properties": { "level": { "const": "narrow" } } } } }, "legacy_projection": { "properties": { "size": { "const": "small" } } } } },
              { "properties": { "task_assessment": { "properties": { "scope_breadth": { "properties": { "level": { "const": "cross_layer" } } } } }, "legacy_projection": { "properties": { "size": { "const": "medium" } } } } },
              { "properties": { "task_assessment": { "properties": { "scope_breadth": { "properties": { "level": { "const": "system_wide" } } } } }, "legacy_projection": { "properties": { "size": { "const": "large" } } } } }
            ]
          },
          {
            "oneOf": [
              { "properties": { "task_assessment": { "properties": { "failure_impact": { "properties": { "level": { "const": "low" } } } } }, "legacy_projection": { "properties": { "risk": { "const": "low" } } } } },
              { "properties": { "task_assessment": { "properties": { "failure_impact": { "properties": { "level": { "const": "medium" } } } } }, "legacy_projection": { "properties": { "risk": { "const": "medium" } } } } },
              { "properties": { "task_assessment": { "properties": { "failure_impact": { "properties": { "level": { "const": "high" } } } } }, "legacy_projection": { "properties": { "risk": { "const": "high" } } } } }
            ]
          },
          {
            "oneOf": [
              { "properties": { "task_assessment": { "properties": { "plan_floor": { "properties": { "level": { "const": "no_plan" } } } } }, "legacy_projection": { "properties": { "planning_route_hint": { "const": "no_plan" } } } } },
              { "properties": { "task_assessment": { "properties": { "plan_floor": { "properties": { "level": { "const": "compact_plan" } } } } }, "legacy_projection": { "properties": { "planning_route_hint": { "const": "compact_plan" } } } } },
              { "properties": { "task_assessment": { "properties": { "plan_floor": { "properties": { "level": { "const": "full_plan" } } } } }, "legacy_projection": { "properties": { "planning_route_hint": { "const": "full_plan" } } } } }
            ]
          }
        ]
      }
    }
  ],
  "required": [
    "schema_id",
    "run",
    "stage",
    "project",
    "subject",
    "overall",
    "breadcrumbs",
    "specification",
    "questions",
    "task_profile",
    "handoff"
  ],
  "properties": {
    "schema_id": {
      "enum": ["dd-flow/specification-stage-report@1", "dd-flow/specification-stage-report@2"]
    },
    "run": { "$ref": "#/definitions/run" },
    "stage": { "$ref": "#/definitions/stage" },
    "project": { "$ref": "#/definitions/namedEntity" },
    "subject": { "$ref": "#/definitions/namedEntity" },
    "overall": { "$ref": "#/definitions/overall" },
    "breadcrumbs": {
      "type": "array",
      "items": { "$ref": "#/definitions/breadcrumb" }
    },
    "specification": {
      "type": "object",
      "additionalProperties": true,
      "required": ["problem", "goal", "in_scope", "out_of_scope", "acceptance_criteria", "verification_plan"],
      "properties": {
        "problem": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "actors": { "type": "array", "items": { "type": "string" } },
        "functional_requirements": { "type": "array", "items": { "type": "string" } },
        "nonfunctional_requirements": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "in_scope": { "type": "array", "items": { "type": "string" } },
        "out_of_scope": { "type": "array", "items": { "type": "string" } },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
        "verification_plan": { "type": "string", "minLength": 1 }
      }
    },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/definitions/question" }
    },
    "design_aspects": {
      "type": "array",
      "items": { "$ref": "#/definitions/designAspectDecision" }
    },
    "raw_intake": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "summary"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["captured", "not_applicable", "redacted", "missing", "degraded"]
        },
        "path": { "type": "string" },
        "summary": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" }
      }
    },
    "knowledge_extraction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "status", "summary"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["subagent", "compact_no_subagent", "skipped_no_substantive_input", "degraded"]
        },
        "status": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "candidates_path": { "type": "string" },
        "report_path": { "type": "string" }
      }
    },
    "knowledge_candidates": {
      "type": "object",
      "additionalProperties": true,
      "required": ["total", "by_target_layer", "requires_user_confirmation", "blocked"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "by_target_layer": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "requires_user_confirmation": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "links": {
          "type": "array",
          "items": { "$ref": "#/definitions/breadcrumb" }
        }
      }
    },
    "research_routing": { "$ref": "#/definitions/researchRouting" },
    "method_applicability": {
      "type": "array",
      "items": { "$ref": "#/definitions/methodApplicability" }
    },
    "gap_analysis": { "$ref": "#/definitions/gapAnalysis" },
    "scenario_coverage": { "$ref": "#/definitions/scenarioCoverage" },
    "problem_solution_boundary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "problem_space_owned_by_specify": { "type": "array", "items": { "type": "string" } },
        "solution_space_owned_by_plan_or_agent": { "type": "array", "items": { "type": "string" } },
        "user_question_gate": { "type": "string" }
      }
    },
    "policy_context_spec": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sources": { "type": "object", "additionalProperties": true },
        "gaps": { "type": "object", "additionalProperties": true }
      }
    },
    "task_profile": {
      "type": "object",
      "additionalProperties": true,
      "required": ["size", "risk", "planning_route_hint", "verification_mode"],
      "properties": {
        "size": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "minLength": 1 },
        "planning_route_hint": { "type": "string", "minLength": 1 },
        "verification_mode": { "type": "string", "minLength": 1 }
      }
    },
    "task_assessment": { "$ref": "#/definitions/taskAssessment" },
    "legacy_projection": { "$ref": "#/definitions/legacyProjection" },
    "handoff": {
      "type": "object",
      "additionalProperties": true,
      "required": ["plan_prompt", "must_read", "next_gate"],
      "properties": {
        "plan_prompt": { "type": "string", "minLength": 1 },
        "must_read": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "next_gate": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "taskAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_breadth", "solution_novelty", "solution_uncertainty", "failure_impact", "plan_floor"],
      "properties": {
        "scope_breadth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "surfaces", "reason"],
          "properties": {
            "level": { "enum": ["narrow", "cross_layer", "system_wide"] },
            "surfaces": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "solution_novelty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "surfaces", "reason"],
          "properties": {
            "level": { "enum": ["reuse_existing", "extend_existing", "new_mechanism"] },
            "surfaces": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "solution_uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "surfaces", "reason"],
          "properties": {
            "level": { "enum": ["known", "bounded", "research_required"] },
            "surfaces": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "failure_impact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "surfaces", "reason"],
          "properties": {
            "level": { "enum": ["low", "medium", "high"] },
            "surfaces": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "plan_floor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "surfaces", "reason"],
          "properties": {
            "level": { "enum": ["no_plan", "compact_plan", "full_plan"] },
            "surfaces": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "legacyProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "risk", "planning_route_hint", "verification_mode", "sources"],
      "properties": {
        "size": { "enum": ["small", "medium", "large"] },
        "risk": { "enum": ["low", "medium", "high"] },
        "planning_route_hint": { "enum": ["no_plan", "compact_plan", "full_plan"] },
        "verification_mode": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "risk", "planning_route_hint", "verification_mode"],
          "properties": {
            "size": { "const": "task_assessment.scope_breadth" },
            "risk": { "const": "task_assessment.failure_impact" },
            "planning_route_hint": { "const": "task_assessment.plan_floor" },
            "verification_mode": { "const": "independent_policy" }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": true,
      "required": ["run_id", "run_index"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "run_index": { "type": "string", "minLength": 1 }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "dir", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dir": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "namedEntity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": true,
      "required": ["verdict", "summary", "next_action"],
      "properties": {
        "verdict": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "next_action": { "type": "string", "minLength": 1 }
      }
    },
    "breadcrumb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href", "status"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string" },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "status", "question"],
      "properties": {
        "id": { "type": "string", "pattern": "^Q-[0-9]{3}$" },
        "status": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "why_it_matters": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "impact": { "type": "string" }
            }
          }
        },
        "answer": { "type": "string" },
        "recommendation": { "type": "string" },
        "recommendation_rationale": { "type": "string" },
        "answered_at": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "researchRouting": {
      "type": "object",
      "additionalProperties": true,
      "required": ["selected_level", "questions", "stop_reason"],
      "properties": {
        "selected_level": { "enum": ["skip", "memory_bank_first", "focused_project"] },
        "questions": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "type": "string" } },
        "findings": { "type": "array", "items": { "type": "string" } },
        "analogies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["source", "strength", "user_confirmation_required"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "strength": { "enum": ["binding", "strong", "weak", "conflict"] },
              "proposed_default": { "type": "string" },
              "user_confirmation_required": { "type": "boolean" },
              "evidence": { "type": "array", "items": { "type": "string" } },
              "conflict": { "type": "string" }
            }
          }
        },
        "conflicts": { "type": "array", "items": { "type": "string" } },
        "stop_reason": { "type": "string", "minLength": 1 }
      }
    },
    "methodApplicability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["method", "applicability", "reason", "questions_to_answer", "stop_condition"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "applicability": { "enum": ["not_applicable", "light", "full"] },
        "signals": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string", "minLength": 1 },
        "questions_to_answer": { "type": "array", "items": { "type": "string" } },
        "stop_condition": { "type": "string", "minLength": 1 }
      }
    },
    "gapAnalysis": {
      "type": "object",
      "additionalProperties": true,
      "required": ["research", "methods", "gaps", "scenario_coverage", "requirement_updates"],
      "properties": {
        "research": { "$ref": "#/definitions/researchRouting" },
        "methods": { "type": "array", "items": { "type": "string" } },
        "gaps": { "type": "array", "items": { "$ref": "#/definitions/gap" } },
        "scenario_coverage": { "$ref": "#/definitions/scenarioCoverage" },
        "requirement_updates": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "source_method", "category", "problem_space", "impact", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^GAP-[0-9]{3}$" },
        "source_method": { "type": "string" },
        "category": { "enum": ["missing", "ambiguous", "conflicting", "unverified_assumption"] },
        "problem_space": { "type": "boolean" },
        "impact": { "enum": ["blocking", "significant", "non_blocking"] },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "affected_requirement": { "type": "string" },
        "resolution": { "type": "string" },
        "status": { "enum": ["open", "resolved", "deferred"] },
        "question_id": { "type": ["string", "null"] }
      }
    },
    "scenarioCoverage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["happy_paths", "alternate_paths", "error_paths"],
      "properties": {
        "happy_paths": { "type": "array", "items": { "type": "string" } },
        "alternate_paths": { "type": "array", "items": { "type": "string" } },
        "error_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "designAspectDecision": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "source", "applicability", "applicability_reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "applicability": {
          "type": "string",
          "enum": ["applicable", "not_applicable", "unknown"]
        },
        "applicability_reason": { "type": "string", "minLength": 1 },
        "canonical_defaults": {
          "type": "string",
          "enum": ["accepted", "accepted_with_deviations", "rejected", "not_applicable", "unknown"]
        },
        "accepted_defaults": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "deviations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["item", "decision", "reason"],
            "properties": {
              "item": { "type": "string", "minLength": 1 },
              "decision": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "user_overrides": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "questions_closed": {
          "type": "array",
          "items": { "type": "string", "pattern": "^Q-[0-9]{3}$" }
        },
        "verification_seeds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "linked_plan_aspects": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
