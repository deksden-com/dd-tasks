{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dd-flow/vnext-specify-result@2",
  "title": "vNext SPECIFY semantic result",
  "description": "Portable semantic contract. A RUN is validated against its bound dd-flow engine schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "outcome", "summary", "specification", "assumptions", "questions", "research_routing", "method_applicability", "gap_analysis", "scenario_coverage", "problem_solution_boundary", "design_aspects", "policy_context", "task_assessment", "legacy_projection", "delivery_shape", "handoff"],
  "properties": {
    "schema_id": { "const": "dd-flow/vnext-specify-result@2" },
    "outcome": { "enum": ["waiting_for_user", "specified", "failed", "cancelled"] },
    "summary": { "type": "string", "minLength": 1 },
    "specification": { "type": "object" },
    "assumptions": { "type": "array" },
    "questions": { "type": "array" },
    "research_routing": { "type": "object" },
    "method_applicability": { "type": "array", "minItems": 9, "maxItems": 9 },
    "gap_analysis": { "type": "object" },
    "scenario_coverage": { "type": "object" },
    "problem_solution_boundary": { "type": "object" },
    "design_aspects": { "type": "array" },
    "policy_context": { "type": "object", "additionalProperties": false, "required": ["sources", "findings", "gaps"], "properties": { "sources": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "task_assessment": { "type": "object" },
    "legacy_projection": { "type": "object" },
    "delivery_shape": { "type": "object" },
    "handoff": { "type": "object" }
  }
}
