{
  "schema_id": "dd-flow/vnext-flow@1",
  "id": "mb-sdlc-vnext-protocolize",
  "version": 4,
  "start": "specify.default",
  "stages": {
    "specify": {
      "entries": {
        "default": {
          "actions": [
            {"handler": "specify.bootstrap"},
            {"agent": {"prompt": "specify.md", "result_format": "markdown"}},
            {"handler": "specify.accept"}
          ],
          "transitions": {
            "specified": "protocolize.default",
            "failed": "terminal.failed",
            "cancelled": "terminal.cancelled"
          }
        }
      }
    },
    "protocolize": {
      "entries": {
        "default": {
          "actions": [
            {"handler": "protocolize.prepare"},
            {"agent": {"prompt": "protocolize.md", "result_format": "json"}},
            {"handler": "protocolize.accept"}
          ],
          "transitions": {
            "protocolized": "plan.default",
            "failed": "terminal.failed",
            "cancelled": "terminal.cancelled"
          }
        }
      }
    },
    "plan": {
      "entries": {
        "default": {
          "actions": [
            {"handler": "plan.prepare"},
            {"agent": {"prompt": "plan.md", "result_format": "files"}},
            {"handler": "plan.accept"}
          ],
          "transitions": {"planned": "plan-review.default", "failed": "terminal.failed", "cancelled": "terminal.cancelled"}
        }
      }
    },
    "plan-review": {
      "entries": {
        "default": {
          "actions": [
            {"handler": "plan-review.prepare"},
            {"agent": {"prompt": "plan-review.md", "result_format": "files"}},
            {"handler": "plan-review.accept"}
          ],
          "transitions": {"off": "code.default", "accepted": "code.default", "blocked": "terminal.blocked", "failed": "terminal.failed", "cancelled": "terminal.cancelled"}
        }
      }
    },
    "code": {
      "entries": {
        "default": {
          "actions": [
            {"handler": "code.prepare"},
            {"agent": {"prompt": "code.md", "result_format": "implementation"}},
            {"handler": "code.accept"}
          ],
          "transitions": {"verified": "terminal.done", "blocked": "terminal.blocked", "failed": "terminal.failed", "cancelled": "terminal.cancelled"}
        }
      }
    }
  }
}
