{
  "schema_id": "dd-flow/code-check-profile@7",
  "runner_evidence_by_alias": {
    "@check/db-verify-local": { "schema_id": "dd-flow/check-runner-evidence@1", "path": "db-verify.runner.json" },
    "@check/api-contract": { "schema_id": "dd-flow/check-runner-evidence@1", "path": "api-contract.runner.json" },
    "@check/api-unit": { "schema_id": "dd-flow/check-runner-evidence@1", "path": "api-unit.runner.json" },
    "@check/api-integration": { "schema_id": "dd-flow/check-runner-evidence@1", "path": "api-integration.runner.json" },
    "@check/web-unit": { "schema_id": "dd-flow/check-runner-evidence@1", "path": "web-unit.runner.json" },
    "@check/browser": { "schema_id": "dd-flow/check-runner-evidence@1", "path": "browser.runner.json" },
    "@check/quality": { "schema_id": "dd-flow/check-runner-evidence@1", "path": "quality.runner.json" }
  },
  "aliases": {
    "@check/api-contract": "pnpm test:api-contract",
    "@check/api-unit": "pnpm --filter @dd-tasks/api test:unit",
    "@check/api-integration": "pnpm --filter @dd-tasks/api test:integration",
    "@check/web-unit": "pnpm test:web",
    "@check/web-build": "pnpm build:web",
    "@check/db-migrate-local": "pnpm db:migrate -- --target local --run-id {run_id}",
    "@check/db-verify-local": "pnpm db:verify -- --target local --run-id {run_id}",
    "@check/quality": "pnpm quality",
    "@check/docs": "pnpm docs:check",
    "@check/browser": "pnpm test:browser"
  },
  "require_alias_for": {
    "pnpm db:migrate": "@check/db-migrate-local",
    "pnpm db:check": "@check/db-verify-local",
    "pnpm db:verify": "@check/db-verify-local"
  },
  "mandatory_by_gate": {
    "readiness": ["@check/db-verify-local"],
    "code": [
      "@check/quality",
      "@check/docs"
    ],
    "merge": [
      "@check/db-verify-local",
      "@check/quality",
      "@check/docs"
    ]
  },
  "inputs_by_alias": {
    "@check/api-contract": ["apps/api", "scripts", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "tsconfig.base.json", "vitest.config.ts", "drizzle.config.ts", "docker-compose.yml", "apps/web/package.json"],
    "@check/api-unit": ["apps/api", "scripts", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "tsconfig.base.json", "vitest.config.ts", "drizzle.config.ts", "docker-compose.yml", "apps/web/package.json"],
    "@check/api-integration": ["apps/api", "scripts", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "tsconfig.base.json", "vitest.config.ts", "drizzle.config.ts", "docker-compose.yml", "apps/web/package.json"],
    "@check/web-unit": ["apps/web", "scripts", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "tsconfig.base.json", "vitest.config.ts", "apps/api/package.json"],
    "@check/web-build": ["apps/web", "scripts", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "tsconfig.base.json"],
    "@check/browser": ["apps/api", "apps/web", "scripts", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "tsconfig.base.json", "vitest.config.ts", "drizzle.config.ts", "docker-compose.yml"]
  },
  "ports_by_alias": {
    "@check/browser": ["api", "web"]
  }
