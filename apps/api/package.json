{
  "name": "@dd-tasks/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/commands.ts migrate",
    "db:check": "tsx src/db/commands.ts check",
    "db:reset": "tsx src/db/commands.ts reset",
    "db:seed": "tsx src/db/commands.ts seed",
    "test": "tsx scripts/test-world.ts integration vitest run --config vitest.config.ts",
    "test:contract": "tsx scripts/test-world.ts integration vitest run --config vitest.config.ts tests/api-json-contract.test.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "tsx scripts/test-world.ts integration vitest run --config vitest.integration.config.ts",
    "format": "biome check --write .",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.7.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.0",
    "vitest": "^3.0.8"
  }
}
